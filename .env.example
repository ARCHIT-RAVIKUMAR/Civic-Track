# Copy this file to ".env" (git-ignored) and fill in real values.
# Supabase: Project Settings -> Database -> Connection string (JDBC / Session pooler is the safest choice)
DB_URL=jdbc:postgresql://YOUR-HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# Optional: creates the first administrator on startup if none exists with this email
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
# NOTIFICATION_MODE=email
# UPLOAD_DIR=uploads
